{
  "name": "kotoba-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run test:local && npm run build && npm run e2e",
    "local": "node local/iniciar.mjs",
    "test:local": "python -I -m unittest discover -s local -p \"test_*.py\"",
    "vozes": "python -I scripts/placa.py --nome vozes --vram 4 -- node scripts/gravar-vozes.mjs",
    "vozes-pt:voz1": "python -I scripts/placa.py --nome vozes-pt-voz1 --vram 11 -- node scripts/gravar-vozes-pt.mjs --voz1",
    "vozes-pt:voz2": "python -I scripts/placa.py --nome vozes-pt-voz2 --vram 3 -- node scripts/gravar-vozes-pt.mjs --voz2"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
